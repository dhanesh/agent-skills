{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dhanesh/agent-skills/skill-contract/task-plan/v1",
  "title": "skill-contract task-plan/v1 payload",
  "description": "The predicate.payload of a task-plan/v1 envelope written by spec_to_tasks.py --envelope.",
  "type": "object",
  "required": ["title", "spec", "tasks", "coverage", "uncovered"],
  "properties": {
    "title": {"type": "string"},
    "spec": {"type": "string", "description": "Repo-relative path of the spec the plan came from."},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirement_ids", "title", "verify"],
        "properties": {
          "id": {"type": "string", "pattern": "^T[0-9]+$"},
          "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^R[0-9]+$"}},
          "title": {"type": "string"},
          "where": {"type": "string"},
          "verify": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["text", "command"],
              "properties": {
                "text": {"type": "string"},
                "command": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"type": "string"}}]}
              }
            }
          }
        }
      }
    },
    "coverage": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "uncovered": {"type": "array", "items": {"type": "string"}},
    "constraints": {
      "type": "array",
      "description": "Optional: the spec's Constrain-step constraints, when it has any (task-plan/v1 stays v1 — additive).",
      "items": {
        "type": "object",
        "required": ["id", "type", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[BTUSO][0-9]+$"},
          "type": {"type": "string", "enum": ["invariant", "goal", "boundary"]},
          "text": {"type": "string"}
        }
      }
    },
    "required_truths": {
      "type": "array",
      "description": "Optional: the spec's Anchor-step required truths, when it has any.",
      "items": {
        "type": "object",
        "required": ["id", "status", "text", "parent", "maps_to", "reqs", "confidence", "check"],
        "properties": {
          "id": {"type": "string", "pattern": "^RT[0-9]+$"},
          "status": {"type": "string", "enum": ["SATISFIED", "PARTIAL", "NOT_SATISFIED", "SPECIFICATION_READY"]},
          "text": {"type": "string"},
          "parent": {"type": "string"},
          "maps_to": {"type": "array", "items": {"type": "string"}},
          "reqs": {"type": "array", "items": {"type": "integer"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "check": {"type": "string"}
        }
      }
    },
    "decisions": {
      "type": "array",
      "description": "Optional: the spec's unattended-mode Decisions sweep, when it has any.",
      "items": {
        "type": "object",
        "required": ["id", "question", "answer", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^D[0-9]+$"},
          "question": {"type": "string"},
          "answer": {"type": "string"},
          "source": {"type": "string"}
        }
      }
    }
  }
}
