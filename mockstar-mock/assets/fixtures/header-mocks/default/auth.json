{
  "mocks": [
    {
      "id": "get-me",
      "match": { "method": "GET", "path": "/me", "headers": { "Authorization": { "startsWith": "Bearer " } } },
      "response": { "kind": "static", "status": 200, "body": { "id": "u_1" } }
    },
    {
      "id": "list-items",
      "match": { "method": "GET", "path": "/items", "headers": { "x-api-key": "k" } },
      "response": { "kind": "static", "status": 200, "body": [] },
      "scenarios": [
        { "id": "tenant-b", "when": { "headers": { "X-Tenant-Id": "b" } }, "response": { "status": 200, "body": [] } }
      ]
    },
    {
      "id": "health-ish",
      "match": { "method": "GET", "path": "/ping" },
      "response": { "kind": "static", "status": 200, "body": "ok" }
    }
  ]
}
