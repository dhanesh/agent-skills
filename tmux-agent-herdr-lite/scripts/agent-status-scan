#!/usr/bin/env bash
set -euo pipefail

ROOT="${AGENT_TMUX_ROOT:-$HOME/.tmux/agent-panes}"
PANE_DIR="$ROOT/panes"
STATE="$ROOT/state.json"
IDLE_SECONDS="${AGENT_IDLE_SECONDS:-120}"
# Directory holding this script and agent_classify.py (same dir after install).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
mkdir -p "$PANE_DIR"

python3 - "$PANE_DIR" "$STATE" "$IDLE_SECONDS" "$SCRIPT_DIR" <<'PY'
import hashlib, json, os, subprocess, sys, time
from datetime import datetime, timezone

pane_dir, state_path, idle_s, mod_dir = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
sys.path.insert(0, mod_dir)
from agent_classify import classify_explain, infer_agent, load_manifests  # noqa: E402  (path set above)

MANIFESTS = load_manifests(os.path.join(os.path.dirname(pane_dir), 'detect'))

now = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
now_ts = time.time()

def sh(args):
    return subprocess.run(args, text=True, capture_output=True)

def capture(pane_id):
    r = sh(['tmux','capture-pane','-p','-J','-t',pane_id])
    return r.stdout if r.returncode == 0 else ''

def all_pane_titles():
    # One subprocess answers both "does this pane exist" and "what is its
    # title" for every pane (agents set titles via OSC 0/2 — Herdr reads the
    # same signal: a braille-spinner title means the agent is streaming).
    #
    # Returns (titles, ok). The `ok` flag is load-bearing: "tmux could not
    # answer" must NEVER be read as "every pane is gone". Collapsing the two
    # let a server restart — exactly when list-panes fails, and exactly when
    # agent-resume is needed — wipe the whole registry on the next status-bar
    # tick, five seconds later.
    r = sh(['tmux','list-panes','-a','-F','#{pane_id}\t#{pane_title}'])
    if r.returncode != 0:
        return {}, False
    titles = {}
    for line in r.stdout.splitlines():
        pane_id, _, title = line.partition('\t')
        if pane_id:
            titles[pane_id] = title
    return titles, True

def focused_panes():
    # Active pane of each attached client — "viewed" panes. Format expansion
    # runs in the client's context, so one call is enough (and session names
    # with spaces can't corrupt the targets).
    r = sh(['tmux','list-clients','-F','#{pane_id}'])
    if r.returncode != 0:
        return set()
    return {p for p in r.stdout.splitlines() if p}

TITLES, TMUX_OK = all_pane_titles()
if not TMUX_OK:
    # No server (restart, socket gone, tmux not on PATH). We cannot capture panes
    # either, so there is nothing truthful to compute — leave every record and the
    # last state.json untouched and let the next tick do the work.
    print('agent-status-scan: tmux unreachable; registry left intact', file=sys.stderr)
    raise SystemExit(0)
FOCUSED = focused_panes()

# A record whose pane is gone is what agent-resume exists to relaunch, so it is
# marked dead, not deleted — deletion is unrecoverable. The graveyard is bounded
# by age so it cannot grow without limit.
GRAVEYARD_TTL = float(os.environ.get('AGENT_GRAVEYARD_TTL_SECONDS', 7 * 24 * 3600))

def status_for(text, title, meta):
    # Compute activity (hash change) and idle here; the classifier stays pure.
    h = hashlib.sha256(text.encode('utf-8', 'ignore')).hexdigest()
    changed = h != meta.get('last_hash', '')
    if changed:
        meta['last_hash'] = h
        meta['last_changed_at'] = now
        meta.pop('done_viewed_hash', None)
    last = meta.get('last_changed_at') or meta.get('created_at') or now
    try:
        last_ts = datetime.fromisoformat(last.replace('Z', '+00:00')).timestamp()
    except Exception:
        last_ts = now_ts
    idle_elapsed = now_ts - last_ts
    agent = meta.get('agent') or infer_agent(meta.get('command', ''))
    status, reason = classify_explain(text, changed, idle_elapsed, idle_s,
                                      meta.get('status', 'working'),
                                      agent=agent, title=title, manifests=MANIFESTS)
    meta['reason'] = reason
    # Herdr semantics: 'done' persists until the human views the pane, then it
    # becomes 'idle'. Viewing is "pane focused in an attached client"; the
    # viewed hash pins the demotion until new output arrives. Demotion only
    # applies to an already-persisted 'done' so the transition itself is
    # observable for at least one scan (agent-wait, notifications).
    if status == 'done':
        if meta.get('done_viewed_hash') == h:
            status = 'idle'
        elif meta.get('pane_id') in FOCUSED and meta.get('status') == 'done':
            meta['done_viewed_hash'] = h
            status = 'idle'
    return status

def notify(meta, status):
    # Fire-and-forget toast/sound on transitions needing attention (Herdr's
    # request/done cues). agent-notify itself suppresses focused panes.
    hook = os.path.join(mod_dir, 'agent-notify')
    if not os.access(hook, os.X_OK):
        return
    try:
        subprocess.Popen([hook, meta.get('name') or meta.get('window') or '?', status],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

items=[]
for fn in sorted(os.listdir(pane_dir)):
    if not fn.endswith('.json'): continue
    path=os.path.join(pane_dir,fn)
    try:
        meta=json.load(open(path))
    except Exception:
        continue
    prev=meta.get('status','unknown')
    pane_id=meta.get('pane_id')
    if not pane_id or pane_id not in TITLES:
        # Pane is gone. Keep the record so agent-resume can relaunch it, but mark
        # it dead and drop it from `items` so the status bar still shows only the
        # live fleet. Only a record that has been dead past the TTL is removed.
        died = meta.get('died_at_ts')
        if died is None:
            meta['dead'] = True
            meta['died_at'] = now
            meta['died_at_ts'] = now_ts
            meta['status'] = 'dead'
            try:
                with open(path, 'w') as fh:
                    json.dump(meta, fh, indent=2)
            except OSError:
                pass
        elif now_ts - died > GRAVEYARD_TTL:
            try: os.remove(path)
            except OSError: pass
        continue
    if meta.pop('dead', None):
        # tmux reissued this pane id to a live pane — the record is current again.
        meta.pop('died_at', None); meta.pop('died_at_ts', None)
    text=capture(pane_id)
    meta['status']=status_for(text, TITLES[pane_id].strip(), meta)
    # Herdr suppresses toasts for the active tab: skip focused panes here
    # rather than re-deriving focus inside agent-notify.
    if (meta['status'] != prev and meta['status'] in ('blocked','error','done')
            and pane_id not in FOCUSED):
        notify(meta, meta['status'])
    meta['updated_at']=now
    json.dump(meta, open(path,'w'), indent=2)
    items.append(meta)

json.dump({'updated_at': now, 'items': items}, open(state_path,'w'), indent=2)
PY
