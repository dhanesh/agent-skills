#!/usr/bin/env bash
set -euo pipefail

# agent-pane: launch/register a command in tmux for Herdr-lite agent supervision.
# Usage: agent-pane [--agent <kind>] [--cwd <dir>] <name> <command...>
#   --agent  detection manifest to use. Kinds are the AGENT_MANIFESTS keys in
#            agent_classify.py: claude, codex, gemini, opencode (kilo), amp,
#            cursor, copilot, droid, cline, devin, kimi, kiro, grok, hermes,
#            qodercli, antigravity, pi. Aliases like claude-code/cursor-agent
#            are normalized. Inferred from the command if omitted.
#   --cwd    working directory for the new window (e.g. an agent-worktree path).

AGENT_KIND=""
CWD=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent) AGENT_KIND="${2:?--agent needs a kind}"; shift 2 ;;
    --cwd) CWD="${2:?--cwd needs a directory}"; shift 2 ;;
    *) break ;;
  esac
done

NAME="${1:-}"
if [[ -z "$NAME" ]]; then
  echo "usage: agent-pane [--agent <kind>] [--cwd <dir>] <name> <command...>" >&2
  exit 64
fi
shift || true
if [[ $# -eq 0 ]]; then
  echo "agent-pane: command required" >&2
  exit 64
fi

SESSION="${AGENT_TMUX_SESSION:-agents}"
ROOT="${AGENT_TMUX_ROOT:-$HOME/.tmux/agent-panes}"
PANE_DIR="$ROOT/panes"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
mkdir -p "$PANE_DIR"

CMD="$*"
SAFE_NAME="$(printf '%s' "$NAME" | tr -cs '[:alnum:]_.-' '-' | sed 's/^-//; s/-$//')"
[[ -n "$SAFE_NAME" ]] || SAFE_NAME="agent"

# Create session if absent.
if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux new-session -d -s "$SESSION" -n control
fi

# Create a window for this agent. If name exists, create unique suffix.
WIN="$SAFE_NAME"
if tmux list-windows -t "$SESSION" -F '#W' | grep -Fxq "$WIN"; then
  WIN="${SAFE_NAME}-$(date +%H%M%S)"
fi

# Run the wrapper as the window's command instead of typing it with
# send-keys: a typed command is echoed by the shell, and the echoed
# 'AGENT_STATUS: done' literal in the wrapper would pin a silent
# long-running command as done. The shell stays open after exit so output
# remains inspectable. POSIX printf only — tmux runs this via sh -c.
WRAP="printf 'AGENT_STATUS: working name=%s\\n' '$SAFE_NAME'; $CMD; rc=\$?; printf '\\nAGENT_STATUS: done exit_code=%s\\n' \"\$rc\"; exec \"\${SHELL:-/bin/sh}\""
NEW_WINDOW=(tmux new-window -d -t "$SESSION" -n "$WIN")
[[ -n "$CWD" ]] && NEW_WINDOW+=(-c "$CWD")
"${NEW_WINDOW[@]}" -- "$WRAP"
PANE_ID="$(tmux display-message -p -t "$SESSION:$WIN" '#{pane_id}')"

# Store metadata before launch so scanner can see it immediately. All values
# travel as argv so quotes/backslashes in the command can't break the JSON.
META="$PANE_DIR/${PANE_ID#%}.json"
NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
python3 - "$META" "$SCRIPT_DIR" "$AGENT_KIND" "$CWD" "$CMD" \
  "${AGENT_NAME:-$NAME}" "$SESSION" "$WIN" "$PANE_ID" "$NOW" <<'PY'
import json,sys
path, mod_dir, agent, cwd, cmd, name, session, win, pane_id, now = sys.argv[1:11]
sys.path.insert(0, mod_dir)
from agent_classify import AGENT_ALIASES, infer_agent
# Normalize aliases (claude-code -> claude) so an explicit --agent hits the
# manifest table the same way an inferred one does.
agent = AGENT_ALIASES.get(agent, agent)
data={
  "name": name,
  "session": session,
  "window": win,
  "pane_id": pane_id,
  "command": cmd,
  "agent": agent or infer_agent(cmd),
  "cwd": cwd,
  "status": "working",
  "created_at": now,
  "updated_at": now,
  "last_hash": "",
  "last_changed_at": now,
}
open(path,"w").write(json.dumps(data, indent=2))
PY

echo "$PANE_ID"
