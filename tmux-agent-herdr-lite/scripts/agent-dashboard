#!/usr/bin/env bash
set -euo pipefail

ROOT="${AGENT_TMUX_ROOT:-$HOME/.tmux/agent-panes}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCAN="${AGENT_STATUS_SCAN:-$SCRIPT_DIR/agent-status-scan}"
STATE="$ROOT/state.json"

if [[ -x "$SCAN" ]]; then
  "$SCAN" >/dev/null 2>&1 || true
fi

python3 - "$STATE" <<'PY'
import json,sys,os,datetime
state_path=sys.argv[1]
icons={"blocked":"⚠","working":"●","done":"✓","idle":"○","unknown":"?","error":"✖"}
order={"blocked":0,"error":1,"working":2,"idle":3,"done":4,"unknown":5}
print("TMUX AGENT COCKPIT")
print("="*70)
if not os.path.exists(state_path):
    print("No state file yet. Start panes with: agent-pane <name> <command>")
    sys.exit(0)
try:
    data=json.load(open(state_path))
except Exception as e:
    print(f"Cannot read state: {e}")
    sys.exit(1)
panes=data.get("items", []) if isinstance(data,dict) else data
if not panes:
    print("No registered panes. Start panes with: agent-pane <name> <command>")
    sys.exit(0)
for p in sorted(panes, key=lambda x:(order.get(x.get('status','unknown'),9), x.get('name',''))):
    status=p.get('status','unknown')
    name=p.get('name','?')
    pane=p.get('pane_id','?')
    win=p.get('window','?')
    agent=p.get('agent') or '-'
    updated=p.get('updated_at') or p.get('last_changed_at') or ''
    reason=p.get('reason') or p.get('matched_pattern') or ''
    print(f"{icons.get(status,'?')} {status:<8} {name:<20} agent={agent:<9} pane={pane:<6} window={win:<14} {updated}")
    if reason:
        print(f"    reason: {reason}")
print("\nKEYS  (prefix a enters the agent table, then one key)")
print("  prefix a b  jump blocked         prefix a e    jump error (crashed)")
print("  prefix a w  jump working         prefix a i    jump idle")
print("  prefix a f  jump finished (done)")
print("  prefix a d  this dashboard       prefix a m    action menu")
print("  prefix a s  refresh scan         prefix a t    choose session/tree")
print("  (pane navigation, splits, zoom and copy mode stay your own bindings)")
print("\nCOORDINATION  agent-list --json | agent-read | agent-send | agent-run")
print("              agent-wait --status/--match | agent-explain | agent-resume")
print("              agent-worktree create <branch> --window")
PY
