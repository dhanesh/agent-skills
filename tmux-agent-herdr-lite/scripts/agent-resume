#!/usr/bin/env bash
set -euo pipefail

# agent-resume: relaunch registered agents after a tmux server restart
# (Herdr's resume_agents_on_restore). Pane records under ~/.tmux/agent-panes/
# survive the server, so every record whose pane is gone is relaunched with
# agent-pane in its saved cwd. Where the agent CLI supports native session
# resume, pass the session ref with --session-id and the command is rewritten
# with the agent's resume flag (Herdr's per-agent resume table):
#
#   claude --resume <id> · codex resume <id> · cursor-agent --resume <id>
#   copilot --resume=<id> · droid --resume <id> · opencode --session <id>
#
# Usage:
#   agent-resume            relaunch all dead registered agents
#   agent-resume --dry-run  print what would be relaunched
#   agent-resume <name> --session-id <id>   relaunch one agent, resuming its
#                                            native CLI session

DRY=0
TARGET=""
SESSION_ID=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY=1; shift ;;
    --session-id) SESSION_ID="${2:?--session-id needs a value}"; shift 2 ;;
    *) TARGET="$1"; shift ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT_PANE="${AGENT_PANE_BIN:-$SCRIPT_DIR/agent-pane}"

python3 - "$SCRIPT_DIR" "$DRY" "$TARGET" "$SESSION_ID" "$AGENT_PANE" <<'PY'
import json, os, shlex, subprocess, sys
sys.path.insert(0, sys.argv[1])
from agent_registry import load_records, pane_dir  # noqa: E402

dry, target, session_id, agent_pane = sys.argv[2] == "1", sys.argv[3], sys.argv[4], sys.argv[5]

# Herdr src/agent_resume.rs plan(): how each agent CLI reopens a session.
RESUME_FLAGS = {
    "claude": lambda i: ["claude", "--resume", i],
    "codex": lambda i: ["codex", "resume", i],
    "cursor": lambda i: ["cursor-agent", "--resume", i],
    "copilot": lambda i: ["copilot", f"--resume={i}"],
    "droid": lambda i: ["droid", "--resume", i],
    "opencode": lambda i: ["opencode", "--session", i],
    "gemini": lambda i: ["gemini", "--resume", i],
}

def pane_alive(pane_id):
    # Compare the echoed id: some tmux builds exit 0 with empty output for a
    # dead pane target, so the return code alone is not trustworthy.
    r = subprocess.run(["tmux", "display-message", "-p", "-t", pane_id, "#{pane_id}"],
                       capture_output=True, text=True)
    return r.returncode == 0 and r.stdout.strip() == pane_id

def relaunch(rec, resume_id=""):
    cmd = rec.get("command", "")
    agent = rec.get("agent", "")
    if resume_id:
        plan = RESUME_FLAGS.get(agent)
        if plan is None:
            print(f"agent-resume: no native resume known for agent "
                  f"'{agent or '(unknown)'}' — relaunching original command",
                  file=sys.stderr)
        else:
            cmd = " ".join(shlex.quote(t) for t in plan(resume_id))
    argv = [agent_pane]
    if agent:
        argv += ["--agent", agent]
    if rec.get("cwd"):
        argv += ["--cwd", rec["cwd"]]
    argv += [rec.get("name", "agent"), cmd]
    if dry:
        print("would run:", " ".join(shlex.quote(a) for a in argv))
        return
    subprocess.run(argv, check=True)
    # The old record now points at a dead pane; agent-pane wrote a fresh one.
    old = os.path.join(pane_dir(), rec.get("pane_id", "%_")[1:] + ".json")
    if os.path.exists(old):
        os.unlink(old)
    print(f"resumed {rec.get('name')} ({cmd})")

records = load_records()
if target:
    picked = [r for r in records if r.get("name") == target or r.get("window") == target]
    if not picked:
        print(f"agent-resume: no record named '{target}'", file=sys.stderr)
        raise SystemExit(1)
    relaunch(picked[0], session_id)
    raise SystemExit(0)

dead = [r for r in records if not pane_alive(r.get("pane_id", ""))]
if not dead:
    print("all registered agents are still running; nothing to resume")
    raise SystemExit(0)
for rec in dead:
    relaunch(rec)
PY
