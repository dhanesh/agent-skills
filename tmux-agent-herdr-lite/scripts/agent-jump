#!/usr/bin/env bash
set -euo pipefail

# agent-jump: focus the next pane in a given state, cycling.
# Usage: agent-jump blocked|error|working|idle|done
# Repeating the jump walks every matching pane in turn (stable order: session,
# window, pane), starting after the pane you are on, then wraps.
# Herdr parity: 'idle' also matches 'done' (finished-and-unviewed) — and
# jumping to a done pane views it, so the next scan demotes it to idle.
# Exits 1 when no pane matches (with a status-line message when inside tmux).

TARGET_STATUS="${1:-blocked}"
ROOT="${AGENT_TMUX_ROOT:-$HOME/.tmux/agent-panes}"
STATE="$ROOT/state.json"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCAN="${AGENT_STATUS_SCAN:-$SCRIPT_DIR/agent-status-scan}"

if [[ -x "$SCAN" ]]; then "$SCAN" >/dev/null 2>&1 || true; fi

CURRENT="$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)"
ORDER="$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null || true)"

PANE_ID="$(python3 - "$STATE" "$TARGET_STATUS" "$CURRENT" "$ORDER" <<'PY'
import json, os, sys
state, wanted, current, order = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4].split()
if not os.path.exists(state): raise SystemExit(1)
items=json.load(open(state)).get('items',[])
accept = {wanted, 'done'} if wanted == 'idle' else {wanted}
rank = {p: i for i, p in enumerate(order)}
matches = sorted({it['pane_id'] for it in items
                  if it.get('status') in accept and it.get('pane_id')},
                 key=lambda p: (rank.get(p, len(rank)), p))
if not matches: raise SystemExit(1)
# Next match after the current pane in tmux's own order, wrapping around.
pos = rank.get(current, -1)
after = [p for p in matches if rank.get(p, len(rank)) > pos]
print((after or matches)[0])
PY
)" || {
  MSG="agent-jump: no pane with status '$TARGET_STATUS'"
  echo "$MSG" >&2
  tmux display-message "$MSG" 2>/dev/null || true
  exit 1
}

# Actually navigate: select the pane and its window, and move this client's
# session if needed (switch-client alone only resolves the session — it does
# not change the active window or pane).
tmux select-pane -t "$PANE_ID"
tmux select-window -t "$PANE_ID"
tmux switch-client -t "$PANE_ID" 2>/dev/null || true
