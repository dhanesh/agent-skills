#!/usr/bin/env bash
set -euo pipefail

# agent-run: send a command line to an agent pane and press Enter atomically
# (Herdr `pane run` — preferred over separate send-text + send-keys Enter).
# Usage: agent-run <name|window|pane-id> <command...>

TARGET="${1:-}"
[[ -n "$TARGET" ]] || { echo "usage: agent-run <name|pane> <command...>" >&2; exit 64; }
shift
[[ $# -gt 0 ]] || { echo "agent-run: command required" >&2; exit 64; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PANE_ID="$(python3 "$SCRIPT_DIR/agent_registry.py" resolve "$TARGET" pane_id)"

tmux send-keys -l -t "$PANE_ID" -- "$*"
tmux send-keys -t "$PANE_ID" Enter
